PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# LLM — server-side only; never put these in VITE_*
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2

# Optional geo extras (Nominatim/Photon/Overpass work without these)
REDIS_URL=
GEOAPIFY_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Pedestrian routing (Phase 6). Empty = labeled euclidean×1.3 fallback.
OPENROUTESERVICE_API_KEY=
GRAPHHOPPER_API_KEY=

# Optional server-side spatial / weather proxies (prefer over browser secrets)
# MAPTILER_KEY=
# CESIUM_ION_TOKEN=
# OPENWEATHER_API_KEY=

# Labeled API fixtures only — not live OSM (default false)
LOCAL_DEV_DATA_SOURCE=false

# Auth / saved itineraries — if DATABASE_URL is set, JWT_SECRET (>=16 chars) is required at boot
# DATABASE_URL=postgres://user:pass@localhost:5432/trailforge
# JWT_SECRET=change-me-min-16-chars
