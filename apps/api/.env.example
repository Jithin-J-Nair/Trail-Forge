PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
LLM_PROVIDER=mock
# Server-side only — never expose to the browser
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2
# Optional geo extras (Nominatim/Photon/Overpass work without these)
REDIS_URL=
GEOAPIFY_API_KEY=
MAPBOX_ACCESS_TOKEN=
OPENROUTESERVICE_API_KEY=
# Labeled API fixtures only — not live OSM (default false)
LOCAL_DEV_DATA_SOURCE=false
# Required only for auth / saved itineraries
# DATABASE_URL=postgres://...
# JWT_SECRET=change-me-min-16-chars
