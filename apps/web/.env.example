# Vite proxies /api → http://localhost:3001 (see vite.config.ts).
# No LLM secrets in the browser.
# VITE_API_ORIGIN=http://localhost:5173
# VITE_DEMO_MODE=true

# Optional spatial upgrades (Phase 3). Empty = OSM footprint extrusions only.
# Publishable MapTiler key may unlock a future MapLibre 2D layer (coverage partial).
# VITE_MAPTILER_KEY=
# Cesium ion token: prefer a server-side proxy; do not claim photoreal without a wired adapter.
# VITE_CESIUM_ION_TOKEN=

# Optional weather (Phase 5). Off by default — never invents rain/snow.
# Opt in to keyless Open-Meteo: VITE_WEATHER_PROVIDER=openmeteo
# VITE_WEATHER_PROVIDER=
