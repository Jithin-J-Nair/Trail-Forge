# Copy secrets into apps/api/.env for local API development.
# Browser never receives LLM/routing secrets. Publishable web keys: apps/web/.env.example.

PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2

# Optional geo / cache
# REDIS_URL=
# GEOAPIFY_API_KEY=
# MAPBOX_ACCESS_TOKEN=

# Pedestrian routing (Phase 6) — empty = labeled euclidean detour
# OPENROUTESERVICE_API_KEY=
# GRAPHHOPPER_API_KEY=

# Optional server-side spatial / weather proxies
# MAPTILER_KEY=
# CESIUM_ION_TOKEN=
# Google Map Tiles API — Photorealistic 3D Tiles (server-only; never VITE_*)
GOOGLE_MAPS_API_KEY=
# OPENWEATHER_API_KEY=

# LOCAL_DEV_DATA_SOURCE=false
# DATABASE_URL=postgres://user:pass@localhost:5432/trailforge
# JWT_SECRET=change-me-min-16-chars
