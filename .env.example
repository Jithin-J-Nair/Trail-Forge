# Copy values into apps/api/.env for local development.
# Browser never receives these secrets (LLM). Spatial publishable keys live in apps/web/.env.example.
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
ANTHROPIC_API_KEY=
OLLAMA_HOST=

# Optional future server-side spatial proxy (Phase 3+). Prefer these over VITE_ for secret tokens.
# MAPTILER_KEY=
# CESIUM_ION_TOKEN=

# Optional server-side weather proxy (Phase 5+). Prefer over browser keys for OpenWeather etc.
# OPENWEATHER_API_KEY=
